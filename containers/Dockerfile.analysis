# Python analysis environment: stratified SV metrics, concordance, phasing stats, methylation/ASM analysis, figures
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tabix procps && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir \
      numpy==2.2.6 pandas==2.3.1 scipy==1.16.1 statsmodels==0.14.5 matplotlib==3.10.5 pysam==0.23.3
WORKDIR /work
