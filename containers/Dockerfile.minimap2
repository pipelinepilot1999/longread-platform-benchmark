# minimap2 + samtools + seqkit: slicing, tag-preserving FASTQ export, downsampling, alignment, QC
FROM mambaorg/micromamba:1.5.10
RUN micromamba install -y -n base -c conda-forge -c bioconda \
      minimap2=2.30 samtools=1.21 seqkit=2.13.0 htslib=1.21 procps-ng && \
    micromamba clean -a -y
ENV PATH=/opt/conda/bin:$PATH
USER root
