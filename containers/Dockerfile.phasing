# WhatsHap read-based phasing / haplotagging + samtools/bcftools for indexing
FROM mambaorg/micromamba:1.5.10
RUN micromamba install -y -n base -c conda-forge -c bioconda \
      whatshap=2.8 samtools=1.21 bcftools=1.21 htslib=1.21 procps-ng && \
    micromamba clean -a -y
ENV PATH=/opt/conda/bin:$PATH
USER root
