manifest {
    name            = 'longread-platform-benchmark'
    author          = 'pipelinepilot1999'
    description     = 'ONT vs PacBio HiFi on HG002 chr20: structural variants, read-based phasing and allele-specific methylation'
    version         = '1.0.0'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
}

nextflow.enable.dsl = 2

params {
    // ---- which platform this run processes (the pipeline runs one platform at a time by design, see docs/decisions.md D-007)
    stage           = 'platform'                   // 'platform' (one platform end to end) | 'compare' (cross-platform stage)
    platform        = 'ont'                        // 'ont' | 'hifi'
    raw_bam         = null                         // chr20 slice of the public aligned BAM (reads pre-selected by original chr20 alignment)
    sample          = 'HG002'
    chrom           = 'chr20'
    chrom_len       = 64444167

    // ---- reference and annotations -------------------------------------
    ref_fasta       = '/home/ec2-user/wgs-wes/ref/GRCh38.fa'   // GCA_000001405.15_GRCh38_no_alt_analysis_set (D-001)
    resources       = '/home/ec2-user/longread/resources'
    truth_sv_vcf    = "${params.resources}/v5.0q/HG002_GRCh38_v5.0q_stvar.vcf.gz"
    truth_sv_bed    = "${params.resources}/v5.0q/HG002_GRCh38_v5.0q_stvar.benchmark.bed"
    truth_sm_vcf    = "${params.resources}/v5.0q/HG002_GRCh38_v5.0q_smvar.vcf.gz"
    truth_sm_bed    = "${params.resources}/v5.0q/HG002_GRCh38_v5.0q_smvar.benchmark.bed"
    strat_dir       = "${params.resources}/strat/GRCh38@all"
    trf_bed         = "${params.resources}/human_GRCh38_no_alt_analysis_set.trf.bed"   // Sniffles2 tandem-repeat annotation
    cpg_islands     = "${params.resources}/cpgIslandExt.hg38.txt.gz"
    gene_gtf        = "${params.resources}/gencode.v50.basic.annotation.gtf.gz"
    imprinted_bed   = "${params.resources}/imprinted_dmrs.chr20.hg38.bed"

    // ---- design knobs (each is a logged decision) -----------------------
    target_cov      = null          // matched-coverage target (x); null = no downsampling. Set from native coverages (D-006)
    downsample_seed = 11
    min_sv_len      = 50
    clair3_model    = [ont: 'r1041_e82_400bps_sup_v500', hifi: 'hifi_revio']
    mm_preset       = [ont: 'map-ont', hifi: 'map-hifi']
    // cuteSV: documented recommendations per platform (D-009)
    cutesv_args     = [ont : '--max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3',
                       hifi: '--max_cluster_bias_INS 1000 --diff_ratio_merging_INS 0.9 --max_cluster_bias_DEL 1000 --diff_ratio_merging_DEL 0.5']
    // Truvari regimes (D-010): name -> arguments
    truvari_regimes = [permissive: '--refdist 1000 --pctseq 0 --pctsize 0.5 --typeignore',
                       'default' : '--refdist 500 --pctseq 0.7 --pctsize 0.7',
                       strict    : '--refdist 100 --pctseq 0.9 --pctsize 0.9']
    min_site_cov    = 5             // per-haplotype minimum CpG coverage for phased methylation (D-014)
    min_site_cov_unphased = 10
    min_free_gb     = 40            // disk guard
    best_caller     = null          // [ont: ..., hifi: ...] for the compare stage; set from Arm A F1
    smoke           = false         // ~50k reads end-to-end
    smoke_reads     = 50000

    outdir          = "results/${params.platform}"
}

process {
    executor      = 'local'
    errorStrategy = { task.exitStatus == 75 ? 'terminate' : (task.attempt < 2 ? 'retry' : 'terminate') }
    maxRetries    = 1
    cache         = 'deep'          // content hashing: re-generated identical inputs must resume as identical

    withLabel: disk_guard { beforeScript = "bash $projectDir/scripts/check_disk.sh ${params.min_free_gb}" }

    withName: 'BAM_TO_FASTQ'        { cpus = 2; memory = '4 GB';  container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'NATIVE_COVERAGE'     { cpus = 2; memory = '4 GB';  container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'DOWNSAMPLE'          { cpus = 2; memory = '4 GB';  container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'MINIMAP2_INDEX'      { cpus = 4; memory = '14 GB'; container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'MINIMAP2_ALIGN'      { cpus = 6; memory = '16 GB'; container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'SUBSET_CHROM'        { cpus = 2; memory = '4 GB';  container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'ASSERT_TAGS'         { cpus = 1; memory = '2 GB';  container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'READ_STATS'          { cpus = 2; memory = '4 GB';  container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'ALIGN_QC'            { cpus = 2; memory = '4 GB';  container = 'longread-platform-benchmark/minimap2:2.30' }
    withName: 'MOSDEPTH'            { cpus = 2; memory = '4 GB';  container = 'quay.io/biocontainers/mosdepth:0.3.14--h87be163_2' }
    withName: 'SNIFFLES'            { cpus = 4; memory = '8 GB';  container = 'longread-platform-benchmark/sniffles:2.8.0' }
    withName: 'CUTESV'              { cpus = 4; memory = '8 GB';  container = 'longread-platform-benchmark/cutesv:2.1.4' }
    withName: 'TRUTH_PREP'          { cpus = 1; memory = '4 GB';  container = 'longread-platform-benchmark/truvari:5.4.0' }
    withName: 'TRUVARI_BENCH'       { cpus = 2; memory = '6 GB';  container = 'longread-platform-benchmark/truvari:5.4.0' }
    withName: 'CALLER_CONCORDANCE'  { cpus = 2; memory = '6 GB';  container = 'longread-platform-benchmark/truvari:5.4.0' }
    withName: 'PLATFORM_CONCORDANCE'{ cpus = 2; memory = '6 GB';  container = 'longread-platform-benchmark/truvari:5.4.0' }
    withName: 'CLAIR3'              { cpus = 6; memory = '14 GB'; container = 'longread-platform-benchmark/clair3:2.0.2' }
    withName: 'HAPPY'               { cpus = 2; memory = '10 GB'; container = 'longread-platform-benchmark/happy:0.3.15' }
    withName: 'WHATSHAP_PHASE'      { cpus = 2; memory = '8 GB';  container = 'longread-platform-benchmark/whatshap:2.8' }
    withName: 'WHATSHAP_STATS'      { cpus = 1; memory = '4 GB';  container = 'longread-platform-benchmark/whatshap:2.8' }
    withName: 'WHATSHAP_COMPARE'    { cpus = 1; memory = '4 GB';  container = 'longread-platform-benchmark/whatshap:2.8' }
    withName: 'WHATSHAP_HAPLOTAG'   { cpus = 4; memory = '8 GB';  container = 'longread-platform-benchmark/whatshap:2.8' }
    withName: 'MODKIT_PILEUP'       { cpus = 4; memory = '8 GB';  container = 'longread-platform-benchmark/modkit:0.6.4' }
    withName: 'MODKIT_PILEUP_PHASED'{ cpus = 4; memory = '8 GB';  container = 'longread-platform-benchmark/modkit:0.6.4' }
    withLabel: 'analysis'           { cpus = 2; memory = '8 GB';  container = 'longread-platform-benchmark/analysis:1.0' }
}

executor {
    name   = 'local'
    cpus   = 8
    memory = '30 GB'    // the host is shared with two other pipelines; stay inside this envelope
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
    temp       = 'auto'
}

trace   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.${params.stage}.txt"; fields = 'task_id,hash,name,status,exit,realtime,cpus,%cpu,peak_rss,script' }
report  { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.${params.stage}.html" }
timeline{ enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.${params.stage}.html" }
